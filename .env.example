# =============================================================================
# Imprint Diamond — copy to `.env` and fill values
#   cp .env.example .env
# Loaded by main.py / scripts via python-dotenv. Never commit `.env`.
# =============================================================================

# --- Database (required — Supabase Postgres only; no Neon / SQLite / local file) ---
# Project Settings → Database → Connection string (URI).
# Prefer Session pooler on Windows (IPv4). Use Direct or Session port 5432 —
# not Transaction pooler (6543). App uses psycopg_pool.
#
# Session pooler:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Direct:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Hosts must be *.supabase.co or *.pooler.supabase.com (neon.tech is rejected).
DATABASE_URL=
# Optional process pool sizes (keep max low vs Session pooler / worker count):
# DB_POOL_MIN=1
# DB_POOL_MAX=4

# --- Auth (required) ---
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Session absolute + idle TTLs (optional; defaults shown)
# SESSION_DAYS=30
# SESSION_IDLE_MINUTES=20160
# ADMIN_SESSION_HOURS=24
# ADMIN_IDLE_MINUTES=720
# --- Google Sign-In (optional) ---

# Web OAuth client ID only (…apps.googleusercontent.com). Never put a client secret here.
# Console → Credentials → that client → Authorized JavaScript origins (not redirect URIs).
# Production (required for live Sign-In on this domain — no path, no trailing slash):
#   https://www.imprintdiamond.com
#   https://imprintdiamond.com
# Local (dev.bat): http://127.0.0.1:8080 (and http://localhost:8080 if you type localhost).
# Prefer separate OAuth clients / values for local .env vs Render production.
# Error 400 origin_mismatch = origin missing from that list. See docs/GOOGLE-OAUTH.md
GOOGLE_CLIENT_ID=

# --- Google reCAPTCHA v3 (register page — invisible score) ---
# Create keys at https://www.google.com/recaptcha/admin (reCAPTCHA v3).
# Separate from GOOGLE_CLIENT_ID. Add production host + localhost for local.
# Fail closed on register if SECRET missing.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional score threshold 0.0–1.0 (default 0.5)
# RECAPTCHA_MIN_SCORE=0.5

# --- Registration gate (optional) ---
REQUIRE_INVITE_CODE=0
REGISTRATION_INVITE_CODE=

# --- Email / Resend (optional) ---
RESEND_API_KEY=
RESET_EMAIL_FROM=noreply@imprintdiamond.com
CONTACT_NOTIFY_TO=yuzi010129@gmail.com

# --- Gold quote refresh (GitHub Actions → POST /api/gold-refresh) ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set the same value as repo secret GOLD_REFRESH_SECRET for the workflow.
GOLD_REFRESH_SECRET=

# --- Featured video sync (optional Bearer endpoint) ---
# Primary path: home/about load auto-refreshes featured-video.json when syncedAt
# is missing or older than ~24 hours / 1 day (no Render cron / external crontab needed).
# Admin 「同步最新 6 支」 always force-refreshes.
#
# Optional: POST /api/featured-video-sync with Bearer for manual/external trigger.
# Separate from GOLD_REFRESH_SECRET (least privilege).
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# FEATURED_VIDEO_SYNC_SECRET=
FEATURED_VIDEO_SYNC_SECRET=

# --- Admin release notes unlock (credit long-press on /admin) ---
# Exactly 6 alphanumeric chars. Verified server-side only.
ADMIN_RELEASE_NOTES_PASSWORD=010129

# --- Local server (optional) ---
PORT=8080



# --- Public site URL (password-reset + email absolute links) ---
# Prefer this over RENDER_EXTERNAL_URL so reset links use the marketing domain.
# Production: https://www.imprintdiamond.com
PUBLIC_SITE_URL=https://www.imprintdiamond.com
# SITE_URL=https://www.imprintdiamond.com

# --- Deploy-only (set on Render, not needed locally) ---
# RENDER=true
# RENDER_SERVICE_ID=
# RENDER_EXTERNAL_URL=https://your-service.onrender.com

# --- Supabase Storage (required for admin image uploads) ---
# Python FastAPI uses Storage REST via app/storage.py — do NOT need @supabase/server.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback when SERVICE_ROLE unset (sb_secret_* also works):
# SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=shop-media
# Unused here (Node/@supabase/server / Auth JWKS only):
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_JWKS_URL=
