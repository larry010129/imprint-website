# =============================================================================
# Imprint Diamond — copy to `.env` and fill values
#   cp .env.example .env
# Loaded by main.py / scripts via python-dotenv. Never commit `.env`.
# =============================================================================

# --- Database (required — remote Postgres only; no SQLite / local file fallback) ---
# Neon example (pooler):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
#
# Supabase Session pooler (IPv4-friendly on Windows):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Auth (required) ---
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- Google Sign-In (optional) ---
# See docs/GOOGLE-OAUTH.md
GOOGLE_CLIENT_ID=

# --- Google reCAPTCHA v2 (register page — “I’m not a robot” checkbox) ---
# Create keys at https://www.google.com/recaptcha/admin (reCAPTCHA v2 checkbox).
# Separate from GOOGLE_CLIENT_ID. Add production host + localhost for local.
# Fail closed on register if SECRET missing.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Registration gate (optional) ---
REQUIRE_INVITE_CODE=0
REGISTRATION_INVITE_CODE=

# --- Email / Resend (optional) ---
RESEND_API_KEY=
RESET_EMAIL_FROM=noreply@imprint-diamond.com
CONTACT_NOTIFY_TO=yuzi010129@gmail.com

# --- Local server (optional) ---
PORT=8080

# --- Deploy-only (set on Render, not needed locally) ---
# RENDER=true
# RENDER_SERVICE_ID=
# RENDER_EXTERNAL_URL=https://your-service.onrender.com

# --- Supabase Storage (required for admin image uploads) ---
# Python FastAPI uses Storage REST via app/storage.py — do NOT need @supabase/server.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback when SERVICE_ROLE unset (sb_secret_* also works):
# SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=shop-media
# Unused here (Node/@supabase/server / Auth JWKS only):
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_JWKS_URL=
